		<element name="P1_BUTTON1"/>
		<element name="P1_BUTTON2"/>
		<element name="P1_BUTTON3"/>
		<element name="P2_BUTTON1"/>
		<element name="P2_BUTTON2"/>
		<element name="P2_BUTTON3"/>
	</alwaysOnElements>
</LEDSpicer>
